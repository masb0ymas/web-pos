# Database Turso (libSQL) — isi URL database Anda
DATABASE_URL="libsql://<nama-database>-<org>.aws-ap-northeast-1.turso.io"

# Token akses Turso (buat dengan: turso db tokens create <nama-database>)
TURSO_AUTH_TOKEN=""

